# Netlify and Cloudflare Pages read this file. Vercel reads vercel.json (same headers).
# The sha256 in script-src is the one-line inline script in the <head> of index.html, privacy.html and 404.html.
# If you edit it, recompute the hash (command in README) and update it here and in vercel.json.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-A6ElyeVZ/IV4qfD54hEga7xsUPSMC02aYwsBPHOWWfc='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/images/*
  Cache-Control: public, max-age=2592000

/*.css
  Cache-Control: public, max-age=86400, must-revalidate

/*.js
  Cache-Control: public, max-age=86400, must-revalidate
